{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-brief.sh\"",
            "timeout": 15,
            "statusMessage": "Reading project progress..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-progress.sh\"",
            "timeout": 20,
            "statusMessage": "Validating progress.json..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/progress-guard.sh\"",
            "timeout": 30,
            "statusMessage": "Checking the progress record..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/check-progress.mjs:*)",
      "Bash(bash scripts/doctor.sh:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(just:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(//home/viettel/App_project/Downpour/**)"
    ],
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
