# Rust
/target/
**/*.rs.bk
*.pdb

# Node / extension
node_modules/
dist/
.pnpm-store/

# Downpour runtime artefacts — never commit user data
*.dppart
*.dpj
*.sqlite
*.sqlite-wal
*.sqlite-shm
/state/*.local.json

