# Secrets — belt and braces; docs/10 forbids these in the repo entirely
.env
.env.*
*.pem
*.key
!tests/**/testonly-*.pem
!tests/**/testonly-*.key

# Agent local state
.claude/settings.local.json
.codex/state/
