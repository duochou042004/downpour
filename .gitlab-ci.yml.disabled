# Downpour GitLab CI — DISABLED.
#
# GitLab runs nothing without a config at the default path, so this file being named
# `.gitlab-ci.yml.disabled` is what keeps the pipeline off. To re-enable, rename it back to
# `.gitlab-ci.yml`. See docs/adr/0011-ci-on-github-actions.md.
#
# WHY IT IS OFF: the project exhausted GitLab's 400 free monthly minutes during Stage 1. Every
# pipeline now fails with `ci_quota_exceeded` before a job starts. CI moved to GitHub Actions, where
# standard runners are free and unmetered for public repositories.
#
# WHY IT IS STILL MAINTAINED: the original version of this file is what burned the minutes, and
# leaving that version here would mean re-enabling it re-creates the problem. Measured cost of the
# old pipeline (pipeline 2727373674, commit 4924ac5): 1706 s = 28.4 min of billed compute per run,
# which is 14 pipelines per monthly quota. The fixes below mirror .github/workflows/ci.yml:
#
#   OLD                                          NEW
#   fmt, clippy, unit, corpus = 4 rust jobs      one `rust` job, one compile, one cache
#   unit ran --workspace AND corpus ran -p        --workspace already covers the corpus (-633 s)
#     downpour-corpus (the same tests twice)
#   `cargo install` x6, compiling ~300 crates    cargo-binstall fetches prebuilt binaries
#     each time (cargo-audit alone: 370-511 s)
#   ~/.cargo/bin NOT cached, so every install    .cargo/bin cached, so tools persist
#     recompiled from scratch every job
#   fmt and clippy shared a cache key in the     one rust job, so no intra-stage cache race
#     same stage and clobbered each other

stages: [harness, rust, security]

default:
  interruptible: true
  tags: [saas-linux-small-amd64]

variables:
  CARGO_TERM_COLOR: always
  # Incremental compilation costs time and cache size in CI (docs/adr/0011).
  CARGO_INCREMENTAL: "0"
  # Test debug info is the biggest contributor to target/ size, and size is paid twice: once
  # pushing the cache and once pulling it.
  CARGO_PROFILE_TEST_DEBUG: "0"
  CARGO_NET_RETRY: "3"
  RUSTUP_MAX_RETRIES: "3"
  RUST_BACKTRACE: "1"
  CARGO_HOME: $CI_PROJECT_DIR/.cargo

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == "master"
    - if: $CI_COMMIT_BRANCH == "develop"
    - if: $CI_COMMIT_BRANCH =~ /^(feature|fix|docs|chore)\//
    - if: $CI_COMMIT_TAG

# ---------------------------------------------------------------- harness (no Rust)

harness:
  stage: harness
  image: node:24-alpine
  before_script:
    - apk add --no-cache bash grep coreutils findutils diffutils git
  script:
    - node scripts/check-progress.mjs
    - bash scripts/sync-agent-assets.sh --check
    - bash scripts/check-links.sh
  rules:
    - when: always

shell-lint:
  stage: harness
  image: koalaman/shellcheck-alpine:stable
  script:
    - shellcheck -S warning scripts/*.sh .claude/hooks/*.sh .githooks/*
  rules:
    - when: always

secret-scan:
  stage: harness
  image: alpine:3.22
  before_script:
    - apk add --no-cache git grep
  script:
    # docs/10-security-privacy-legal.md: no secrets in the repository, ever.
    - |
      if git grep -nIE '(BEGIN [A-Z ]*PRIVATE KEY|glpat-[A-Za-z0-9_-]{20}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})' \
           -- ':!*.gitignore' ':!.gitlab-ci.yml*' ':!.github/workflows/*'; then
        echo "Potential secret committed. See SECURITY.md."; exit 1
      fi
    - echo "no secrets found"
  rules:
    - when: always

# ---------------------------------------------------------------- rust

.rust-base: &rust-base
  image: rust:1.97-bookworm
  cache:
    # Keyed on Cargo.lock: unchanged dependencies mean the previous target/ is reusable.
    key:
      files: [Cargo.lock]
      prefix: cargo-v2
    paths:
      # .cargo/bin is the entry the old config was missing. Without it, every `cargo install`
      # recompiled its tool from scratch in every job of every pipeline.
      - .cargo/bin
      - .cargo/registry/index
      - .cargo/registry/cache
      - .cargo/git/db
      - target/
  rules:
    - exists: [Cargo.toml]

# Fetch prebuilt tool binaries instead of compiling them. GitLab has no equivalent of
# taiki-e/install-action, so cargo-binstall does the same job: it downloads from GitHub Releases.
.install-tools: &install-tools
  - |
    if ! command -v cargo-binstall >/dev/null 2>&1; then
      curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
    fi

rust:
  <<: *rust-base
  stage: rust
  script:
    - *install-tools
    - cargo binstall --no-confirm --only-signed cargo-nextest || cargo binstall --no-confirm cargo-nextest
    - rustup component add rustfmt clippy
    # One job, one compile. fmt first because it is the cheapest thing that can fail.
    - cargo fmt --all -- --check
    - cargo clippy --locked --all-targets --all-features -- -D warnings
    # --workspace covers downpour-corpus; there is deliberately no separate corpus job.
    - cargo nextest run --locked --workspace --profile ci
    - cargo test --locked --workspace --doc
  artifacts:
    when: always
    reports:
      junit: target/nextest/ci/junit.xml
    expire_in: 1 week

# ---------------------------------------------------------------- security

security:
  <<: *rust-base
  stage: security
  cache:
    key:
      files: [Cargo.lock]
      prefix: cargo-security-v2
    paths: [.cargo/bin, .cargo/registry/index, .cargo/registry/cache, .cargo/git/db]
  script:
    - *install-tools
    - cargo binstall --no-confirm cargo-deny cargo-audit
    - |
      if [ -f deny.toml ]; then
        cargo deny check licenses bans sources advisories
      else
        echo "deny.toml does not exist yet (backlog B-2); skipping cargo deny"
      fi
    - cargo audit --deny warnings
  allow_failure: false

# ---------------------------------------------------------------- slow corpus (scheduled only)

slow-corpus:
  <<: *rust-base
  stage: rust
  timeout: 1h
  script:
    - *install-tools
    - cargo binstall --no-confirm cargo-nextest
    - cargo nextest run --locked -p downpour-corpus --release --run-ignored all
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
      exists: [Cargo.toml]
